<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/abu_terang">

        <!-- Card Grafik Agregasi -->
        <androidx.cardview.widget.CardView
            style="@style/CardPutih"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_sedang">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margin_sedang">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Penjualan Bulanan"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/hijau_gelap"
                    android:layout_marginBottom="8dp"/>

                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/chartAgregasi"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Label List Bulan -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pilih Periode Penjualan"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/teks_utama"
            android:paddingHorizontal="@dimen/margin_sedang"
            android:paddingBottom="8dp"/>

        <!-- RecyclerView Periode -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPeriode"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="@dimen/margin_sedang"
            android:paddingBottom="@dimen/margin_sedang"
            android:clipToPadding="false"/>

        <!-- Empty state -->
        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Belum ada data penjualan"
            android:textSize="16sp"
            android:textColor="@color/abu_teks"
            android:gravity="center"
            android:padding="@dimen/margin_besar"
            android:visibility="gone"/>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"/>
    </LinearLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
