<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.SalesForecastingApps" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/hijau_utama</item>
        <item name="colorPrimaryVariant">@color/hijau_gelap</item>
        <item name="colorOnPrimary">@color/putih</item>
        <item name="colorSecondary">@color/hijau_terang</item>
        <item name="colorOnSecondary">@color/putih</item>
        <item name="android:colorBackground">@color/putih</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="CardHijau" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/hijau_latar</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">2dp</item>
    </style>

    <style name="CardPutih" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/putih</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">3dp</item>
    </style>

    <!-- ← Tambahkan style berikut -->

    <style name="TeksJudul">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/hijau_utama</item>
    </style>

    <style name="TeksLabel">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/teks_sekunder</item>
    </style>

    <style name="TombolUtama">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:backgroundTint">@color/hijau_utama</item>
        <item name="android:textColor">@color/putih</item>
        <item name="android:padding">10dp</item>
    </style>

    <style name="Theme.SalesForecastingApps.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_tiracast_logo</item>
        <item name="windowSplashScreenAnimationDuration">500</item>
        <item name="postSplashScreenTheme">@style/Theme.SalesForecastingApps</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@color/splash_bg</item>
        <item name="android:navigationBarColor">@color/splash_bg</item>
    </style>
</resources>